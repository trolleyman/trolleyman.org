{
  "name": "trolleyman.org-remix",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "postbuild": "ts-node scripts/post-build.ts",
    "preview": "npm run build && npm run start",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "new-post": "ts-node scripts/new-post.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@react-router/fs-routes": "^7.9.1",
    "@react-router/node": "^7.9.1",
    "@react-router/serve": "^7.9.1",
    "@types/luxon": "^3.7.1",
    "@vercel/react-router": "^1.2.3",
    "clsx": "^2.1.1",
    "csstype": "^3.1.3",
    "gray-matter": "^4.0.3",
    "http-status-codes": "^2.3.0",
    "isbot": "^5.1.30",
    "luxon": "^3.7.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.1",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.6",
    "tailwind-merge": "^3.3.1",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.13",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20.19.14",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/webfontloader": "^1.6.38",
    "@vitest/ui": "^3.2.4",
    "husky": "^9.1.7",
    "imagetools-core": "^8.0.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vite-imagetools": "^8.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
